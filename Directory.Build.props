<Project>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- CA1716: Our "Desktop"/"Lifecycle" namespaces and some member names intentionally mirror platform vocabulary. -->
    <!-- CA1848: LoggerMessage delegates are used in hot paths; the remaining log calls are rare diagnostics. -->
    <NoWarn>$(NoWarn);CA1716;CA1848;CA1515;CA1031;CA1062;CA1303;CA1724;CA2007;CA1034;CA1711;CA1819;CA1305;CA1056;CA1054;CA1055;CA2234;CA1308;CA1307;CA1309;CA1310;CA1865;CA1866;CA1872;CA1001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Versions">
    <BlazorNativeSdkTargetFramework>net10.0</BlazorNativeSdkTargetFramework>
    <AndroidTargetFramework>net10.0-android</AndroidTargetFramework>
    <IosTargetFramework>net10.0-ios</IosTargetFramework>
    <MacCatalystTargetFramework>net10.0-maccatalyst</MacCatalystTargetFramework>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>BlazorNativeSdk contributors</Authors>
    <Company>BlazorNativeSdk</Company>
    <Product>BlazorNativeSdk</Product>
    <Copyright>Copyright (c) BlazorNativeSdk contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/blazor-native-sdk/blazor-native-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blazor-native-sdk/blazor-native-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;maui;hybrid;native;camera;barcode;biometrics;notifications;deep-links;desktop;tray;ipc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <IsSrcProject Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">true</IsSrcProject>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' != 'true'">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA2201;CA1822;CA1861;CA2000;CA1859;CA1812;CA1852;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSrcProject)' == 'true'">
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
