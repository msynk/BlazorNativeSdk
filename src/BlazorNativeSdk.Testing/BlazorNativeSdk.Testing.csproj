<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(BlazorNativeSdkTargetFramework)</TargetFramework>
    <RootNamespace>BlazorNativeSdk.Testing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Test doubles for BlazorNativeSdk: scriptable fakes for every capability (camera, barcode, files, app storage, secure storage, share, biometrics, clipboard, permissions, notifications, lifecycle, connectivity, background work, transfers, workflow checkpoints, windows, screens, tray, global shortcuts, menus, shell file operations, IPC, single instance, protocol registration) plus framework-agnostic contract checks that adapter test suites run against real implementations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorNativeSdk.Abstractions\BlazorNativeSdk.Abstractions.csproj" />
    <ProjectReference Include="..\BlazorNativeSdk.Core\BlazorNativeSdk.Core.csproj" />
  </ItemGroup>

</Project>
