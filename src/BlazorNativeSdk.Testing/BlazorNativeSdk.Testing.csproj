<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(BlazorNativeSdkTargetFramework)</TargetFramework>
    <RootNamespace>BlazorNativeSdk.Testing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Test doubles for BlazorNativeSdk: scriptable fakes for every capability (camera, barcode, files, secure storage, share, biometrics, clipboard, permissions, notifications, lifecycle, connectivity, windows) plus framework-agnostic contract checks that adapter test suites run against real implementations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorNativeSdk.Abstractions\BlazorNativeSdk.Abstractions.csproj" />
    <ProjectReference Include="..\BlazorNativeSdk.Core\BlazorNativeSdk.Core.csproj" />
  </ItemGroup>

</Project>
