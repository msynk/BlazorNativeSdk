<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>BlazorNativeSdk.WindowsPlatform</RootNamespace>
    <AssemblyName>BlazorNativeSdk.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Windows adapter for BlazorNativeSdk: Win32/WinRT services usable from WPF, Windows Forms and .NET MAUI (WinUI) hosts. Window control, displays, global shortcuts, tray icons, native menus, DPAPI secure storage, Windows Hello, clipboard, file pickers, share UI, toast notifications with activation routing, connectivity, permissions and app storage. References no UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorNativeSdk.Abstractions\BlazorNativeSdk.Abstractions.csproj" />
    <ProjectReference Include="..\BlazorNativeSdk.Core\BlazorNativeSdk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorNativeSdk.Windows.Tests" />
  </ItemGroup>

</Project>
