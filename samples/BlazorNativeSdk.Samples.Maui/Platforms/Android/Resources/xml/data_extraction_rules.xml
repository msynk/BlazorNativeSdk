<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): same exclusion for cloud backups and device-to-device transfers. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="dev.blazornativesdk.samples.microsoft.maui.essentials.preferences.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="dev.blazornativesdk.samples.microsoft.maui.essentials.preferences.xml" />
  </device-transfer>
</data-extraction-rules>
