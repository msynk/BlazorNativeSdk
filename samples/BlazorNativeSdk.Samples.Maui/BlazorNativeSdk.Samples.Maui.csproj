<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>$(AndroidTargetFramework)</TargetFrameworks>
    <!-- Building an iOS or Mac Catalyst app (signing, bundling) needs Xcode, so those targets are included on macOS or when
         asked for explicitly (-p:IncludeAppleTargets=true, for example with a paired Mac). The library builds them anywhere. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) Or '$(IncludeAppleTargets)' == 'true'">$(TargetFrameworks);$(IosTargetFramework);$(MacCatalystTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(WindowsTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>BlazorNativeSdk.Samples.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>BlazorNativeSdk Samples</ApplicationTitle>
    <!-- Also the bundle id (iOS BGTask identifiers derive from it), the Android package and the SDK AppId. -->
    <ApplicationId>dev.blazornativesdk.samples</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged on Windows: single instance through the Desktop adapter, the URL scheme is registered at runtime
         (MauiNativeOptions.RegisterProtocolSchemes). Package.appxmanifest declares the protocol for packaged builds. -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3B5BDB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3B5BDB" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorNativeSdk.Maui\BlazorNativeSdk.Maui.csproj" />
    <ProjectReference Include="..\BlazorNativeSdk.Samples.Shared\BlazorNativeSdk.Samples.Shared.csproj" />
  </ItemGroup>

</Project>
