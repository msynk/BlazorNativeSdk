@inherits LayoutComponentBase
@inject ICapabilityRegistry Registry

<div class="bns-shell">
    <header class="bns-header">
        <span class="bns-brand">BlazorNativeSdk</span>
        <span class="bns-host">
            @Registry.Host
            @if (!RendererInfo.IsInteractive)
            {
                @* Blazor Server prerendering: no browser is attached yet, so capabilities report Unknown / host.not-ready. *@
                <text> · prerendered, connecting…</text>
            }
        </span>
    </header>
    <nav class="bns-nav" aria-label="Sections">
        <NavLink href="" Match="NavLinkMatch.All">Capabilities</NavLink>
        <NavLink href="devices">Devices</NavLink>
        <NavLink href="lifecycle">Lifecycle</NavLink>
        <NavLink href="desktop">Desktop</NavLink>
    </nav>
    <main class="bns-main">
        <ActivationBanner />
        @Body
    </main>
</div>

@* Replays deep links and notification taps received before the UI was ready, and starts SDK background services. *@
<NativeActivationOutlet />
